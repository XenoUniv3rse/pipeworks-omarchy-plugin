{
  "schemaVersion": 1,
  "id": "pipeworks.mixer",
  "name": "Pipeworks Mixer",
  "version": "1.0.0",
  "author": "Ettiene Birkhoff",
  "license": "MIT",
  "description": "Voicemeeter-style virtual audio mixer for PipeWire with MIDI control surface support.",
  "homepage": "https://github.com/ebirkhoff/Pipeworks-Omarche-Pluging",
  "repository": "https://github.com/ebirkhoff/Pipeworks-Omarche-Pluging",
  "keywords": ["audio", "mixer", "volume", "pipewire", "midi", "routing"],
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "MixerWidget.qml"
  },
  "barWidget": {
    "displayName": "Pipeworks Mixer",
    "description": "Per-channel faders, mutes and routing for the Pipeworks audio mixer",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
